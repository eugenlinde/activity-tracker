### Variables
@baseUrl = http://localhost:8080
@activityId = 1
@foreignActivityId = 999

### upload JPEG — expect 201, Location: /api/media/{id}, body { "id": n }
POST {{baseUrl}}/api/activities/{{activityId}}/media
Authorization: Bearer {{authToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="sample.jpeg"
Content-Type: image/jpeg

< ./fixtures/sample.jpg
--WebAppBoundary--

### upload PNG content type — expect 415
POST {{baseUrl}}/api/activities/{{activityId}}/media
Authorization: Bearer {{authToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="sample.png"
Content-Type: image/png

< ./fixtures/sample.jpg
--WebAppBoundary--

### upload to foreign / missing activity — expect 404
POST {{baseUrl}}/api/activities/{{foreignActivityId}}/media
Authorization: Bearer {{authToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="sample.jpg"
Content-Type: image/jpeg

< ./fixtures/sample.jpg
--WebAppBoundary--

### upload without file part — expect 400
POST {{baseUrl}}/api/activities/{{activityId}}/media
Authorization: Bearer {{authToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary--

###############################################################################
# DOWNLOAD — GET /api/media/{id}
# Three users: owner (demo), viewer (demo2, gets a share), third (demo3).
# Run top to bottom. Each login stores its own token.
###############################################################################
@ownerEmail = demo@example.com
@viewerEmail = demo2@example.com
@thirdEmail = demo3@example.com
@password = secret123
@unknownMediaId = 999999

### login owner
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "{{ownerEmail}}", "password": "{{password}}" }

> {%
    client.assert(response.status === 200, "owner login failed: " + response.status);
    client.global.set("ownerToken", response.body.token);
%}

### login viewer
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "{{viewerEmail}}", "password": "{{password}}" }

> {%
    client.assert(response.status === 200, "viewer login failed: " + response.status);
    client.global.set("viewerToken", response.body.token);
%}

### signup third user — 201 first time, 409 after; either is fine
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{ "email": "{{thirdEmail}}", "password": "{{password}}", "firstName": "Third", "lastName": "User" }

### login third
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "{{thirdEmail}}", "password": "{{password}}" }

> {%
    client.assert(response.status === 200, "third login failed: " + response.status);
    client.global.set("thirdToken", response.body.token);
%}

### owner uploads — 201, captures mediaId
POST {{baseUrl}}/api/activities/{{activityId}}/media
Authorization: Bearer {{ownerToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="sample.jpeg"
Content-Type: image/jpeg

< ./fixtures/sample.jpg
--WebAppBoundary--

> {%
    client.assert(response.status === 201, "upload failed: " + response.status);
    client.global.set("mediaId", response.body.id);
%}

### owner downloads — expect 200, Content-Type image/jpeg
GET {{baseUrl}}/api/media/{{mediaId}}
Authorization: Bearer {{ownerToken}}

> {%
    client.test("200", function () {
        client.assert(response.status === 200, "got " + response.status);
    });
    client.test("content-type is image/jpeg", function () {
        const ct = response.headers.valueOf("Content-Type");
        client.assert(ct === "image/jpeg", "got " + ct);
    });
%}

### viewer downloads BEFORE share — expect 403 (200 if a share from an earlier run still exists)
GET {{baseUrl}}/api/media/{{mediaId}}
Authorization: Bearer {{viewerToken}}

### owner grants share to viewer
POST {{baseUrl}}/api/shares
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{ "email": "{{viewerEmail}}" }

### owner lists shares — captures shareId for viewer
GET {{baseUrl}}/api/shares
Authorization: Bearer {{ownerToken}}

> {%
    const share = response.body.find(s => s.email === "demo2@example.com");
    client.assert(share, "no share for viewer found");
    client.global.set("shareId", share.id);
%}

### viewer downloads AFTER share — expect 200
GET {{baseUrl}}/api/media/{{mediaId}}
Authorization: Bearer {{viewerToken}}

> {%
    client.test("200", function () {
        client.assert(response.status === 200, "got " + response.status);
    });
%}

### third user downloads — expect 403
GET {{baseUrl}}/api/media/{{mediaId}}
Authorization: Bearer {{thirdToken}}

> {%
    client.test("403", function () {
        client.assert(response.status === 403, "got " + response.status);
    });
%}

### owner revokes share — expect 204
DELETE {{baseUrl}}/api/shares/{{shareId}}
Authorization: Bearer {{ownerToken}}

### viewer downloads AFTER revoke — expect 403
GET {{baseUrl}}/api/media/{{mediaId}}
Authorization: Bearer {{viewerToken}}

> {%
    client.test("403", function () {
        client.assert(response.status === 403, "got " + response.status);
    });
%}

### unknown media id — expect 403
GET {{baseUrl}}/api/media/{{unknownMediaId}}
Authorization: Bearer {{ownerToken}}

> {%
    client.test("403", function () {
        client.assert(response.status === 403, "got " + response.status);
    });
%}

### no token — expect 401
GET {{baseUrl}}/api/media/{{mediaId}}

###############################################################################
# LIST — GET /api/activities/{id}/media
# Needs ownerToken / viewerToken / thirdToken from the DOWNLOAD logins above.
# Creates a fresh activity so the empty-list case is deterministic.
###############################################################################
@unknownActivityId = 999999

### owner creates a fresh activity — 201, captures listActivityId
POST {{baseUrl}}/api/activities
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{ "activityType": "WEIGHTS", "startedAt": "2026-10-01T07:00:00Z", "duration": "PT30M" }

> {%
    client.assert(response.status === 201, "create failed: " + response.status);
    client.global.set("listActivityId", response.body.id);
%}

### owner lists media of activity with no uploads — expect 200 []
GET {{baseUrl}}/api/activities/{{listActivityId}}/media
Authorization: Bearer {{ownerToken}}

> {%
    client.test("200 empty", function () {
        client.assert(response.status === 200, "got " + response.status);
        client.assert(Array.isArray(response.body) && response.body.length === 0, "got " + JSON.stringify(response.body));
    });
%}

### owner uploads to the fresh activity — 201, captures listMediaId
POST {{baseUrl}}/api/activities/{{listActivityId}}/media
Authorization: Bearer {{ownerToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="sample.jpeg"
Content-Type: image/jpeg

< ./fixtures/sample.jpg
--WebAppBoundary--

> {%
    client.assert(response.status === 201, "upload failed: " + response.status);
    client.global.set("listMediaId", response.body.id);
%}

### owner lists media — expect 200, exactly the uploaded id
GET {{baseUrl}}/api/activities/{{listActivityId}}/media
Authorization: Bearer {{ownerToken}}

> {%
    client.test("200 with uploaded id", function () {
        client.assert(response.status === 200, "got " + response.status);
        const ids = response.body.map(m => m.id);
        client.assert(ids.length === 1 && ids[0] === client.global.get("listMediaId"), "got " + JSON.stringify(ids));
    });
%}

### third user lists — expect 403
GET {{baseUrl}}/api/activities/{{listActivityId}}/media
Authorization: Bearer {{thirdToken}}

> {%
    client.test("403", function () {
        client.assert(response.status === 403, "got " + response.status);
    });
%}

### viewer lists BEFORE share — expect 403 (download walk above revoked it)
GET {{baseUrl}}/api/activities/{{listActivityId}}/media
Authorization: Bearer {{viewerToken}}

> {%
    client.test("403", function () {
        client.assert(response.status === 403, "got " + response.status);
    });
%}

### owner grants share to viewer again
POST {{baseUrl}}/api/shares
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{ "email": "{{viewerEmail}}" }

> {%
    client.assert(response.status === 201, "grant failed: " + response.status);
%}

### owner lists shares — captures listShareId for viewer
GET {{baseUrl}}/api/shares
Authorization: Bearer {{ownerToken}}

> {%
    const share = response.body.find(s => s.email === "demo2@example.com");
    client.assert(share, "no share for viewer found");
    client.global.set("listShareId", share.id);
%}

### viewer lists AFTER share — expect 200 with the uploaded id
GET {{baseUrl}}/api/activities/{{listActivityId}}/media
Authorization: Bearer {{viewerToken}}

> {%
    client.test("200", function () {
        client.assert(response.status === 200, "got " + response.status);
        client.assert(response.body.length === 1, "got " + JSON.stringify(response.body));
    });
%}

### owner revokes share — expect 204
DELETE {{baseUrl}}/api/shares/{{listShareId}}
Authorization: Bearer {{ownerToken}}

> {%
    client.assert(response.status === 204, "revoke failed: " + response.status);
%}

### viewer lists AFTER revoke — expect 403
GET {{baseUrl}}/api/activities/{{listActivityId}}/media
Authorization: Bearer {{viewerToken}}

> {%
    client.test("403", function () {
        client.assert(response.status === 403, "got " + response.status);
    });
%}

### unknown activity id — expect 403 (evaluator denies before service runs)
GET {{baseUrl}}/api/activities/{{unknownActivityId}}/media
Authorization: Bearer {{ownerToken}}

> {%
    client.test("403", function () {
        client.assert(response.status === 403, "got " + response.status);
    });
%}

### list without token — expect 401
GET {{baseUrl}}/api/activities/{{listActivityId}}/media

> {%
    client.test("401", function () {
        client.assert(response.status === 401, "got " + response.status);
    });
%}

###############################################################################
# DELETE — DELETE /api/media/{id}, and DELETE /api/activities/{id} with media
# Needs ownerToken / viewerToken / thirdToken from the DOWNLOAD logins above.
# Check storage/ file count by hand: it drops by one per deleted media.
###############################################################################

### owner creates an activity for the delete walk — captures delActivityId
POST {{baseUrl}}/api/activities
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{ "activityType": "WEIGHTS", "startedAt": "2026-10-01T07:00:00Z", "duration": "PT30M" }

> {%
    client.assert(response.status === 201, "create failed: " + response.status);
    client.global.set("delActivityId", response.body.id);
%}

### owner uploads first media — captures delMediaId
POST {{baseUrl}}/api/activities/{{delActivityId}}/media
Authorization: Bearer {{ownerToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="sample.jpeg"
Content-Type: image/jpeg

< ./fixtures/sample.jpg
--WebAppBoundary--

> {%
    client.assert(response.status === 201, "upload failed: " + response.status);
    client.global.set("delMediaId", response.body.id);
%}

### owner uploads second media — stays attached, removed by activity delete
POST {{baseUrl}}/api/activities/{{delActivityId}}/media
Authorization: Bearer {{ownerToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="sample.jpeg"
Content-Type: image/jpeg

< ./fixtures/sample.jpg
--WebAppBoundary--

> {%
    client.assert(response.status === 201, "upload failed: " + response.status);
    client.global.set("keptMediaId", response.body.id);
%}

### owner grants share to viewer
POST {{baseUrl}}/api/shares
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{ "email": "{{viewerEmail}}" }

> {%
    client.assert(response.status === 201, "grant failed: " + response.status);
%}

### owner lists shares — captures delShareId
GET {{baseUrl}}/api/shares
Authorization: Bearer {{ownerToken}}

> {%
    const share = response.body.find(s => s.email === "demo2@example.com");
    client.assert(share, "no share for viewer found");
    client.global.set("delShareId", share.id);
%}

### third user deletes media — expect 403
DELETE {{baseUrl}}/api/media/{{delMediaId}}
Authorization: Bearer {{thirdToken}}

> {%
    client.test("403", function () {
        client.assert(response.status === 403, "got " + response.status);
    });
%}

### shared viewer deletes media — expect 403 (sharing is read-only)
DELETE {{baseUrl}}/api/media/{{delMediaId}}
Authorization: Bearer {{viewerToken}}

> {%
    client.test("403", function () {
        client.assert(response.status === 403, "got " + response.status);
    });
%}

### delete media without token — expect 401
DELETE {{baseUrl}}/api/media/{{delMediaId}}

> {%
    client.test("401", function () {
        client.assert(response.status === 401, "got " + response.status);
    });
%}

### owner deletes media — expect 204, one file fewer in storage/
DELETE {{baseUrl}}/api/media/{{delMediaId}}
Authorization: Bearer {{ownerToken}}

> {%
    client.test("204", function () {
        client.assert(response.status === 204, "got " + response.status);
    });
%}

### owner deletes same media again — expect 403 (row gone, evaluator denies)
DELETE {{baseUrl}}/api/media/{{delMediaId}}
Authorization: Bearer {{ownerToken}}

> {%
    client.test("403", function () {
        client.assert(response.status === 403, "got " + response.status);
    });
%}

### owner lists activity media — expect only the second media
GET {{baseUrl}}/api/activities/{{delActivityId}}/media
Authorization: Bearer {{ownerToken}}

> {%
    client.test("200 with second media only", function () {
        client.assert(response.status === 200, "got " + response.status);
        const ids = response.body.map(m => m.id);
        client.assert(ids.length === 1 && ids[0] === client.global.get("keptMediaId"), "got " + JSON.stringify(ids));
    });
%}

### third user deletes the activity — expect 404 (activity write path)
DELETE {{baseUrl}}/api/activities/{{delActivityId}}
Authorization: Bearer {{thirdToken}}

> {%
    client.test("404", function () {
        client.assert(response.status === 404, "got " + response.status);
    });
%}

### owner deletes activity that still has media — expect 204, its file gone from storage/
DELETE {{baseUrl}}/api/activities/{{delActivityId}}
Authorization: Bearer {{ownerToken}}

> {%
    client.test("204", function () {
        client.assert(response.status === 204, "got " + response.status);
    });
%}

### owner downloads media of deleted activity — expect 403
GET {{baseUrl}}/api/media/{{keptMediaId}}
Authorization: Bearer {{ownerToken}}

> {%
    client.test("403", function () {
        client.assert(response.status === 403, "got " + response.status);
    });
%}

### owner revokes share — cleanup
DELETE {{baseUrl}}/api/shares/{{delShareId}}
Authorization: Bearer {{ownerToken}}

> {%
    client.assert(response.status === 204, "revoke failed: " + response.status);
%}
