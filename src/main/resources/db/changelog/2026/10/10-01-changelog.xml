<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">
    <changeSet author="eugenl" id="media-creation">
        <createTable tableName="media">
            <column name="id" autoIncrement="true" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_media" />
            </column>
            <column name="activity_id" type="BIGINT">
                <constraints foreignKeyName="fk_media_activity" nullable="false" references="activities(id)" />
            </column>
            <column name="storage_key" type="text">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_media_storage_key" />
            </column>
        </createTable>
    </changeSet>
    <changeSet author="eugenl" id="media-index-activity-id">
        <createIndex indexName="idx_media_activity_id" tableName="media">
            <column name="activity_id" />
        </createIndex>
    </changeSet>
</databaseChangeLog>
