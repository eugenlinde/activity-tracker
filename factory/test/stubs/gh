#!/usr/bin/env bash
echo "gh $*" >> "$STUB_LOG"
if [ -n "${STUB_GH_FAIL_ON:-}" ] && { [ "$1 $2" = "$STUB_GH_FAIL_ON" ] || [ "$1" = "$STUB_GH_FAIL_ON" ]; }; then
  echo "stub: $STUB_GH_FAIL_ON failed" >&2
  exit 1
fi
if [ -n "${STUB_GH_DIR:-}" ]; then
  exact="$STUB_GH_DIR/args/$(printf '%s' "$*" | tr -c 'A-Za-z0-9._-' '_' | cut -c1-200)"
  if [ -e "$exact.1" ]; then
    n=$(cat "$exact.n" 2>/dev/null || echo 0)
    if [ -e "$exact.$((n + 1))" ]; then n=$((n + 1)); fi
    echo "$n" > "$exact.n"
    exact="$exact.$n"
  fi
  if [ -e "$exact" ]; then
    cat "$exact"
    if [ -f "$exact.exit" ]; then exit "$(cat "$exact.exit")"; fi
    exit 0
  fi
  key="$1-$2"
  if [ "$1" = api ]; then
    method=GET
    path=""
    accept=""
    previous=""
    for argument in "$@"; do
      case $previous in
        -X) method=$argument ;;
        -H) accept=$argument ;;
      esac
      case $argument in
        repos/*) path=$argument ;;
      esac
      previous=$argument
    done
    case "$method $path" in
      "GET "*/git/ref/heads/main) key=api-ref-main ;;
      "GET "*/git/ref/heads/*) key=api-ref-branch ;;
      "DELETE "*/git/refs/heads/*) key=api-delete-ref ;;
      "GET "*/git/commits/*) key=api-commit ;;
      "POST "*/git/commits) key=api-create-commit ;;
      "POST "*/git/refs) key=api-create-ref ;;
      "POST "*/pulls) key=api-create-pull ;;
      "POST "*/issues/*/labels) key=api-add-labels ;;
      "GET "*/issues/*/events) key=api-issue-events ;;
      "GET "*/pulls/*) key=api-pull ;;
      "GET "*/commits/*) key=api-commit-diff ;;
      "GET "*/compare/*)
        key=api-compare
        case $accept in *diff*) key=api-compare-diff ;; esac
        ;;
      *) key=api-other ;;
    esac
  fi
  if [ -f "$STUB_GH_DIR/$key" ]; then
    cat "$STUB_GH_DIR/$key"
  fi
  if [ -f "$STUB_GH_DIR/$key.exit" ]; then
    exit "$(cat "$STUB_GH_DIR/$key.exit")"
  fi
  exit 0
fi
case "$1 $2" in
  "pr view") printf '%s\n' "${STUB_PR_JSON:-}" ;;
  "issue view") printf '%s\n' "${STUB_ISSUE_JSON:-}" ;;
  "pr diff") cat "${STUB_PR_DIFF:-/dev/null}" ;;
  "api repos/"*/commits/*) printf '%s\n' "${STUB_COMMIT_LINE:-claude[bot] true}" ;;
  "api repos/"*) cat "${STUB_PR_FILES:-/dev/null}" ;;
esac
exit 0
