<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">
    <changeSet author="eugenl" id="activities-add-user-id">
        <addColumn tableName="activities">
            <column name="user_id" type="BIGINT">
                <constraints foreignKeyName="fk_activities_user" nullable="false" references="users(id)" />
            </column>
        </addColumn>
    </changeSet>
    <changeSet author="eugenl" id="activities-index-user-id">
        <createIndex indexName="idx_activities_user_id" tableName="activities">
            <column name="user_id" />
        </createIndex>
    </changeSet>
</databaseChangeLog>