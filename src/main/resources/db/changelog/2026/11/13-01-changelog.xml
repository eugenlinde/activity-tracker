<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">
    <changeSet author="claude" id="weight-entries-creation">
        <createTable tableName="weight_entries">
            <column name="id" autoIncrement="true" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_weight_entries" />
            </column>
            <column name="user_id" type="BIGINT">
                <constraints foreignKeyName="fk_weight_entries_user" nullable="false" references="users(id)" />
            </column>
            <column name="entry_date" type="DATE">
                <constraints nullable="false" />
            </column>
            <column name="weight_kg" type="NUMERIC(4, 1)">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="timestamptz">
                <constraints nullable="false" />
            </column>
        </createTable>
        <addUniqueConstraint tableName="weight_entries" columnNames="user_id, entry_date"
            constraintName="uq_weight_entries_user_date" />
    </changeSet>
</databaseChangeLog>
