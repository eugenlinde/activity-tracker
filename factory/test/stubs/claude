#!/usr/bin/env bash
echo "claude $*" >> "$STUB_LOG"
echo "claude-env GH_TOKEN=${GH_TOKEN:-unset} GITHUB_TOKEN=${GITHUB_TOKEN:-unset} token=${CLAUDE_CODE_OAUTH_TOKEN:+set} cwd=$(basename "$PWD")" >> "$STUB_LOG"
count=$(cat "$STUB_CLAUDE_COUNT" 2>/dev/null || echo 0)
count=$((count + 1))
echo "$count" > "$STUB_CLAUDE_COUNT"
file=$(printf '%s' "${STUB_CLAUDE_OUTPUTS:-}" | cut -d: -f"$count")
if [ -n "$file" ] && [ -f "$file" ]; then
  cat "$file"
fi
exit "${STUB_CLAUDE_EXIT:-0}"
