<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">
    <changeSet author="eugenl" id="shares-creation">
        <createTable tableName="shares">
            <column name="id" autoIncrement="true" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_shares" />
            </column>
            <column name="owner_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_shares_owner" references="users(id)" />
            </column>
            <column name="viewer_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_shares_viewer" references="users(id)" />
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false" />
            </column>
            <column name="deleted_at" type="timestamptz" />
        </createTable>
    </changeSet>
    <changeSet author="eugenl" id="shares-index-viewer-id">
        <createIndex indexName="idx_shares_viewer_id" tableName="shares">
            <column name="viewer_id" />
        </createIndex>
    </changeSet>
    <changeSet author="eugenl" id="shares-unique-active-pair">
        <sql dbms="postgresql">
            CREATE UNIQUE INDEX uq_shares_active_pair
                ON shares (owner_id, viewer_id)
                WHERE deleted_at IS NULL
        </sql>
        <rollback>
            <sql dbms="postgresql">DROP INDEX uq_shares_active_pair</sql>
        </rollback>
    </changeSet>
    <changeSet author="eugenl" id="shares-check-not-self">
        <sql dbms="postgresql">
            ALTER TABLE shares
                ADD CONSTRAINT ck_shares_not_self CHECK (owner_id &lt;&gt; viewer_id)
        </sql>
        <rollback>
            <sql dbms="postgresql">ALTER TABLE shares DROP CONSTRAINT ck_shares_not_self</sql>
        </rollback>
    </changeSet>
</databaseChangeLog>
