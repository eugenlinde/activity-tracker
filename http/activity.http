### Variables
@baseUrl = http://localhost:8080
@activityType = "WEIGHTS"
@startedAt = "2026-09-23T07:00:00Z"
@duration = "PT1H"
@id = 1
@notes="test1"

### create activity
POST {{baseUrl}}/api/activities
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "activityType": {{activityType}},
  "startedAt": {{startedAt}},
  "duration": {{duration}}
}

### update activity
PUT {{baseUrl}}/api/activities/{{id}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "activityType": {{activityType}},
  "startedAt": {{startedAt}},
  "duration": {{duration}},
  "notes": {{notes}}
}