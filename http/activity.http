### Variables
@baseUrl = http://localhost:8080
@activityType = "WEIGHTS"
@startedAt = "2026-09-23T07:00:00Z"
@duration = "PT1H"
@id = 1
@notes="test1"
@ownerId=2

### create activity
POST {{baseUrl}}/api/activities
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "activityType": {{activityType}},
  "startedAt": {{startedAt}},
  "duration": {{duration}}
}

### create aerobic activity
POST {{baseUrl}}/api/activities
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "activityType": "CYCLING",
  "startedAt": {{startedAt}},
  "duration": "PT30M",
  "notes": {{notes}}
}

### create weights activity with target sets
POST {{baseUrl}}/api/activities
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "activityType": "WEIGHTS",
  "startedAt": {{startedAt}},
  "duration": {{duration}},
  "details": {
    "version": "1",
    "exerciseList": [
      {
        "name": "Back squat",
        "targetSets": 4,
        "targetReps": "8",
        "repsInReserve": "2",
        "workoutSetList": [
          { "weight": 80, "reps": 8 },
          { "weight": 80, "reps": 8 }
        ]
      }
    ]
  }
}

### update activity
PUT {{baseUrl}}/api/activities/{{id}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "activityType": {{activityType}},
  "startedAt": {{startedAt}},
  "duration": {{duration}},
  "notes": {{notes}}
}

### get activities
GET {{baseUrl}}/api/activities
Content-Type: application/json
Authorization: Bearer {{authToken}}

### get activities by ownerId
GET {{baseUrl}}/api/activities?ownerId={{ownerId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

### get single activity
GET {{baseUrl}}/api/activities/{{id}}
Content-Type: application/json
Authorization: Bearer {{authToken}}